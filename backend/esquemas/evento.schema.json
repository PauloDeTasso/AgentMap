{
  "$id": "evento",
  "type": "object",
  "required": ["id", "tipo", "origem", "destino", "referenciaTipo", "referenciaId", "mensagem", "estado", "datas"],
  "properties": {
    "id": { "type": "string", "pattern": "^EVT-[A-Z0-9-]+$", "minLength": 1 },
    "tipo": { "type": "string", "enum": ["HANDOFF_CRIADO", "HANDOFF_ACEITO", "HANDOFF_CONCLUIDO", "TAREFA_CONCLUIDA", "BLOQUEIO_CRIADO", "CONFLITO_DETECTADO", "SOLICITACAO_CRIADA"] },
    "origem": { "type": "string", "minLength": 1 },
    "destino": { "type": "string", "minLength": 1 },
    "referenciaTipo": { "type": "string", "minLength": 1 },
    "referenciaId": { "type": "string", "minLength": 1 },
    "mensagem": { "type": "string", "minLength": 1 },
    "estado": { "type": "string", "enum": ["PENDENTE", "CONSUMIDO"] },
    "datas": {
      "type": "object",
      "required": ["criadoEm", "consumidoEm"],
      "properties": {
        "criadoEm": { "type": ["string", "null"] },
        "consumidoEm": { "type": ["string", "null"] }
      }
    }
  }
}
