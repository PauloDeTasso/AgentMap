{
  "$id": "validacao",
  "type": "object",
  "required": ["id", "alvoTipo", "alvoId", "criterios", "responsavel", "estado", "evidencias", "observacoes", "datas"],
  "properties": {
    "id": { "type": "string", "pattern": "^VAL-[A-Z0-9-]+$", "minLength": 1 },
    "alvoTipo": { "type": "string", "minLength": 1 },
    "alvoId": { "type": "string", "minLength": 1 },
    "tarefaId": { "type": ["string", "null"] },
    "criterios": { "type": "array", "items": { "type": "string" } },
    "responsavel": { "type": "string", "minLength": 1 },
    "estado": { "type": "string", "enum": ["PENDENTE", "APROVADO", "REPROVADO", "APROVADO_COM_RESSALVAS"] },
    "evidencias": { "type": "array", "items": { "type": "string" } },
    "observacoes": { "type": ["string", "null"] },
    "datas": {
      "type": "object",
      "required": ["criadaEm", "atualizadaEm", "concluidaEm"],
      "properties": {
        "criadaEm": { "type": ["string", "null"] },
        "atualizadaEm": { "type": ["string", "null"] },
        "concluidaEm": { "type": ["string", "null"] }
      }
    }
  }
}
