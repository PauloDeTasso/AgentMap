{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": "./src",
    "types": ["node"],
    "paths": {
      "servicios": ["servicios"],
      "servicios/*": ["servicios/*"],
      "tipos": ["tipos"],
      "tipos/*": ["tipos/*"],
      "arquivos": ["arquivos"],
      "arquivos/*": ["arquivos/*"],
      "validacao": ["validacao"],
      "validacao/*": ["validacao/*"],
      "seguranca": ["seguranca"],
      "seguranca/*": ["seguranca/*"],
      "api": ["api"],
      "api/*": ["api/*"],
      "observability": ["observability"],
      "observability/*": ["observability/*"],
      "websocket": ["websocket"],
      "websocket/*": ["websocket/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "testes"]
}
