{
	"$schema": "https://app.kilo.ai/config.json",

	"model": "kilo/nvidia/deepseek-ai/deepseek-v4-flash",

	"mcp": {
		"agentmap": {
			"type": "local",
			"command": [
				"cmd",
				"/c",
				"cd",
				"backend",
				"&&",
				"npx",
				"tsx",
				"src/mcp-server/index.ts"
			],
			"environment": {
				"NODE_ENV": "production"
			},
			"enabled": true,
			"timeout": 30000
		}
	},

	"plugin": [
		"./.kilo/plugin/agentmap-wakeup.ts"
	],

	"provider": {
		"google": {
			"models": {
				"gemini-3.1-pro-preview": {
					"name": "Gemini 3.1 Pro Preview",
					"tool_call": true,
