{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "agentmap": {
      "type": "local",
      "command": ["cmd", "/c", "cd", "backend", "&&", "npx", "tsx", "src/mcp-server/index.ts"],
      "environment": {
        "NODE_ENV": "production"
      },
      "enabled": true,
      "timeout": 30000
    }
  },
  "plugin": [
    "./.kilo/plugin/agentmap-wakeup.ts"
  ],
  "provider": {
    "openrouter": {
      "data_collection_enabled": true
    },
    "kilo": {
      "data_collection_enabled": true
    }
  },
  "hide_prompt_training_models": false,
  "auto_collapse_reasoning": true,
  "experimental": {
    "mcp_timeout": 30000
  }
}

/*
 * COTA DE COLETA DE DADOS
 *
 * data_collection_enabled:
 *   - true  -> permite que o provedor colete dados de uso para melhorar modelos.
 *   - false -> desativa coleta; apenas dados operacionais essenciais são mantidos.
 *
 * Esta configuração NÃO afeta o armazenamento local do AgentMap (.ia/).
 * O AgentMap armazena tudo localmente em arquivos JSON, independentemente desta flag.
 *
 * O valor padrão aqui é true. Sobrescreva no arquivo kilo.local.jsonc (não versionado)
 * para desativar a coleta neste ambiente.
 */

/*
 * CONFIGURAÇÃO DO MCP DO AGENTMAP
 *
 * O AgentMap é exposto ao Kilo Code via MCP local (STDIO).
 * Comando: npx tsx src/mcp-server/index.ts
 * Transporte: stdio (sem exposição de rede)
 */

/*
 * PLUGIN DE WAKE-UP AUTOMÁTICO
 *
 * O plugin agentmap-wakeup.ts implementa o acordar automático do agente
 * principal. Ele escuta eventos session.idle, consulta o AgentMap por
 * mensagens pendentes e injeta um prompt via promptAsync quando há
 * resposta de agente filho.
 *
 * Características de segurança:
 * - Roda dentro do processo Kilo Code (mesmo runtime)
 * - Não expõe portas de rede
 * - Não utiliza credenciais externas
 * - Não escreve arquivos compartilhados
 */
